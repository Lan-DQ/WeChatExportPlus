# ── 构建产物（由 build_dist_plus.py 生成，不进仓库）──
/dist/
/build/
*.spec

# ── 开发期临时链接（dev_setup.py 创建，指向本机原版 WeChatExport）──
/dll/
/runtime/
/electron/
/resources/

# ── Python ──
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/

# ── 本地凭据 / 密钥（绝不提交）──
# 注意：不要在这里写 !*.token 之类的否定规则，否则 .token 会被重新纳入跟踪。
.token
*.token
gh_token*
key.txt
key_status.txt

# ── 导出的聊天记录（含隐私，绝不提交）──
导出_*/
*_图片/
*.jsonl

# ── v3.0 用户数据（程序运行期生成，绝不提交/发布）──
# 会话标签：用户自己打的标签
/会话标签.json
/会话标签.json.tmp
# 用户设置：里面有**使用者的真实目录**（导出目录、上次选过的路径），对外必须脱敏
/.ui_settings
# 界面/宿主运行日志（含运行路径与时间）
/.wv2_start.log
/.ui_errors.log
# 内嵌 DeepSeek 官网页的登录态（Chromium profile，里面有 cookie）
/ds_profile/
/.boot.log
# 假官网页面的自检记录（跑 dsview/verify_mock.py 时生成）
/dsview/mock/mock_events.jsonl

# 发布操作便签（里面的路径是本机私事，不进仓库）
/发布步骤-*.md

# ── 编辑器 / 系统 ──
.vscode/
.idea/
Thumbs.db
desktop.ini
wv2_*_profile/
wv2_profile/
wv2_ud_*/
_test_wv2_settings
_speed_settings
